{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/commerce-hook-lab/hook-pack.schema.json",
  "title": "Commerce Hook Lab Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run",
    "product",
    "audience",
    "objective",
    "facts",
    "hooks",
    "production_packs",
    "test_plan",
    "review"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "language", "created_at"],
      "properties": {
        "mode": {
          "enum": ["quick", "lab", "audit", "iterate"]
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "source_rights", "source_summary"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "source_rights": {
          "enum": ["owned", "licensed", "permission", "unknown"]
        },
        "source_summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "persona",
        "context",
        "pain",
        "desire",
        "awareness_stage",
        "is_inferred"
      ],
      "properties": {
        "persona": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "pain": {
          "type": "string",
          "minLength": 1
        },
        "desire": {
          "type": "string",
          "minLength": 1
        },
        "awareness_stage": {
          "enum": [
            "unaware",
            "problem-aware",
            "solution-aware",
            "product-aware",
            "most-aware"
          ]
        },
        "is_inferred": {
          "type": "boolean"
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "aspect_ratio", "duration_seconds", "goal"],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "aspect_ratio": {
          "type": "string",
          "pattern": "^[0-9]+:[0-9]+$"
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "goal": {
          "enum": ["hold", "click", "add-to-cart", "conversion"]
        }
      }
    },
    "facts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "hooks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/hook"
      }
    },
    "production_packs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/productionPack"
      }
    },
    "test_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis",
        "variant_hook_ids",
        "changed_variable",
        "controlled_variables",
        "primary_metric",
        "secondary_metrics",
        "stop_condition",
        "interpretation_rule"
      ],
      "properties": {
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "variant_hook_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^H[0-9]{2,}$"
          }
        },
        "changed_variable": {
          "type": "string",
          "minLength": 1
        },
        "controlled_variables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "primary_metric": {
          "type": "string",
          "minLength": 1
        },
        "secondary_metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stop_condition": {
          "type": "string",
          "minLength": 1
        },
        "interpretation_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unsupported_claims",
        "human_review_items",
        "limitations"
      ],
      "properties": {
        "unsupported_claims": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "human_review_items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "statement",
        "source_locator",
        "status",
        "visual_proof",
        "requires_human_review",
        "required_companion_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[FQR][0-9]{2,}$"
        },
        "kind": {
          "enum": [
            "product",
            "feature",
            "mechanism",
            "usage",
            "price",
            "offer",
            "result",
            "review",
            "restriction"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "source_locator": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": ["verified", "user-provided", "uncertain", "prohibited"]
        },
        "visual_proof": {
          "type": "string",
          "minLength": 1
        },
        "requires_human_review": {
          "type": "boolean"
        },
        "required_companion_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[FQR][0-9]{2,}$"
          }
        }
      }
    },
    "scoreSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_relevance",
        "audience_fit",
        "first_frame_clarity",
        "curiosity",
        "proofability",
        "feed_native",
        "model_feasibility",
        "distinctness"
      ],
      "properties": {
        "product_relevance": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "audience_fit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "first_frame_clarity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "curiosity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "proofability": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "feed_native": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "model_feasibility": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "distinctness": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "angle",
        "archetype",
        "spoken",
        "visual",
        "text_overlay",
        "supporting_fact_ids",
        "proof_plan",
        "risk_flags",
        "human_review_required",
        "scores",
        "readiness_score",
        "decision"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^H[0-9]{2,}$"
        },
        "angle": {
          "type": "string",
          "minLength": 1
        },
        "archetype": {
          "type": "string",
          "minLength": 1
        },
        "spoken": {
          "type": "string",
          "minLength": 1
        },
        "visual": {
          "type": "string",
          "minLength": 1
        },
        "text_overlay": {
          "type": "string",
          "minLength": 1
        },
        "supporting_fact_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[FQR][0-9]{2,}$"
          }
        },
        "proof_plan": {
          "type": "string",
          "minLength": 1
        },
        "risk_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "regulated-claim",
              "unsupported-number",
              "testimonial",
              "before-after",
              "comparison",
              "scarcity",
              "guarantee",
              "price-or-offer",
              "likeness-or-voice",
              "copyright",
              "ai-demonstration",
              "platform-policy"
            ]
          }
        },
        "human_review_required": {
          "type": "boolean"
        },
        "scores": {
          "$ref": "#/$defs/scoreSet"
        },
        "readiness_score": {
          "type": "number",
          "minimum": 1,
          "maximum": 5
        },
        "decision": {
          "enum": ["advance", "revise", "reject"]
        }
      }
    },
    "timelineBeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_seconds",
        "end_seconds",
        "visual",
        "audio",
        "text_overlay"
      ],
      "properties": {
        "start_seconds": {
          "type": "number",
          "minimum": 0
        },
        "end_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "visual": {
          "type": "string",
          "minLength": 1
        },
        "audio": {
          "type": "string",
          "minLength": 1
        },
        "text_overlay": {
          "type": "string"
        }
      }
    },
    "productionPack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "hook_id",
        "duration_seconds",
        "timeline",
        "cta",
        "content_file",
        "generic_video_prompt",
        "seedance_prompt",
        "reference_assets",
        "generation_constraints",
        "real_footage_notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^P[0-9]{2,}$"
        },
        "hook_id": {
          "type": "string",
          "pattern": "^H[0-9]{2,}$"
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "timeline": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/timelineBeat"
          }
        },
        "cta": {
          "type": "string",
          "minLength": 1
        },
        "content_file": {
          "type": "string",
          "pattern": "^production/[a-z0-9-]+\\.md$"
        },
        "generic_video_prompt": {
          "type": "string",
          "minLength": 1
        },
        "seedance_prompt": {
          "type": "string",
          "minLength": 1
        },
        "reference_assets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "generation_constraints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "real_footage_notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
